# Variables de entorno de ejemplo para Orkela Frontend
# Copia este archivo como .env.local para desarrollo local
# En Netlify, configura estas variables en Site settings > Environment variables

# ===========================================
# API Backend URL
# ===========================================
# URL de tu backend Laravel (sin barra al final)
VITE_API_URL=http://orkela.localhost/api

# ===========================================
# WebSocket (Laravel Reverb)
# ===========================================
VITE_REVERB_APP_KEY=dgczpergxfxyiffhkzvr
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http

# ===========================================
# App Info
# ===========================================
VITE_APP_NAME=Orkela
